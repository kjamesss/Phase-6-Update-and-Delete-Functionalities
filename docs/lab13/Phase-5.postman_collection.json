{
  "info": {
    "name": "BU Task Planner Phase 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "studentPassword",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Student login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{studentPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Student tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"tasks is an array\", () => pm.expect(pm.response.json().tasks).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Student subjects",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"categories is an array\", () => pm.expect(pm.response.json().categories).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Student denied user directory",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"JSON content\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin accounts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"users is an array\", () => pm.expect(pm.response.json().users).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin task overview",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"tasks is an array\", () => pm.expect(pm.response.json().tasks).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    }
  ]
}
